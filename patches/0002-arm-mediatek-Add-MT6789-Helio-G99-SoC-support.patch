 arch/arm/mach-mediatek/mt6789/Makefile        |   3 +
 arch/arm/mach-mediatek/mt6789/init.c          | 122 ++++++++++++++++++
 arch/arm/mach-mediatek/mt6789/lowlevel_init.S |  24 ++++
 6 files changed, 179 insertions(+)
