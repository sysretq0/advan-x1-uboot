diff --git a/board/mediatek/mt6789/mt6789.c b/board/mediatek/mt6789/mt6789.c
new file mode 100644
index 00000000..75fa0426
--- /dev/null
+++ b/board/mediatek/mt6789/mt6789.c
@@ -0,0 +1,138 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Board support for Advan X1 (MediaTek MT6789 / Helio G99).
+ *
+ * Chainloaded from stock LK via the loki embedded subpartition at 0x60000000
+ * with ATF BL31 resident at EL3 (0x48200000) and DSI video-mode scanout
+ * already active on OVL0.
+ */
+
+#include <dm.h>
+#include <env.h>
+#include <fdt_support.h>
+#include <init.h>
+#include <log.h>
+#include <scsi.h>
+#include <stdio.h>
+#include <ufs.h>
+#include <video.h>
+#include <asm/io.h>
+#include <asm/system.h>
+#include <linux/delay.h>
+#include <linux/libfdt.h>
+
+/* MT6789 DISP_OVL0 active Layer 0 physical framebuffer address register */
+#define MT6789_OVL0_L0_ADDR	0x14005f40
+#define MT6789_FB_WINDOW_MIN	0xfe000000U
+#define MT6789_FB_WINDOW_MAX	0xff800000U
+#define MT6789_FB_PHYS_0	0xfe007000U
+#define MT6789_FB_SIZE_BYTES	0x00a3a000U /* 1088 * 4 * 2464 */
+
+extern u32 mt6789_boot_fb;
+
+static u32 mt6789_active_fb(void)
+{
+	u32 ovl_fb = readl(MT6789_OVL0_L0_ADDR);
+
+	if (ovl_fb >= MT6789_FB_WINDOW_MIN && ovl_fb <= MT6789_FB_WINDOW_MAX)
+		return ovl_fb;
+
+	if (mt6789_boot_fb >= MT6789_FB_WINDOW_MIN &&
+	    mt6789_boot_fb <= MT6789_FB_WINDOW_MAX)
+		return mt6789_boot_fb;
+
+	return MT6789_FB_PHYS_0;
+}
+
+#ifdef CONFIG_OF_BOARD_FIXUP
+int board_fix_fdt(void *rw_fdt_blob)
+{
+	static const u32 fb_planes[3] = {
+		MT6789_FB_PHYS_0,
+		MT6789_FB_PHYS_0 + MT6789_FB_SIZE_BYTES,
+		MT6789_FB_PHYS_0 + MT6789_FB_SIZE_BYTES * 2U,
+	};
+	u32 live_fb = mt6789_active_fb();
+	u32 i, p;
+	int node;
+
+	/*
+	 * Stock LK composites OVL0 Layer 0 (0xFE007000, U-Boot's simplefb)
+	 * underneath its video_printf / TUI overlay plane (0xFEA41000) using
+	 * per-pixel alpha (OVL_CON_AEN).
+	 * - Fill the active L0 plane with opaque black (0xFF000000).
+	 * - Zero the other planes in mblock framebuffer (0x00000000, alpha=0)
+	 *   so any Stage-1 Loki TUI overlay becomes 100% transparent instead
+	 *   of drawing an opaque curtain over U-Boot.
+	 */
+	for (p = 0; p < ARRAY_SIZE(fb_planes); p++) {
+		volatile u64 *fb64 = (volatile u64 *)(uintptr_t)fb_planes[p];
+		u64 fill = (fb_planes[p] == live_fb) ? 0xff000000ff000000ULL : 0ULL;
+
+		for (i = 0; i < MT6789_FB_SIZE_BYTES / sizeof(u64); i++)
+			fb64[i] = fill;
+	}
+	dsb();
+
+	/*
+	 * Stock LK double-buffers between 0xFE007000 and 0xFEA41000.
+	 * Use the live FB address handed off from Stage-1 (or OVL0_L0_ADDR)
+	 * and patch simple-framebuffer before DM video probe so U-Boot
+	 * always renders to the visible scanout buffer.
+	 */
+	if (live_fb >= MT6789_FB_WINDOW_MIN && live_fb <= MT6789_FB_WINDOW_MAX) {
+		node = fdt_node_offset_by_compatible(rw_fdt_blob, -1,
+						     "simple-framebuffer");
+		if (node >= 0) {
+			fdt32_t reg[4] = {
+				cpu_to_fdt32(0),
+				cpu_to_fdt32(live_fb),
+				cpu_to_fdt32(0),
+				cpu_to_fdt32(MT6789_FB_SIZE_BYTES),
+			};
+			fdt_setprop_inplace(rw_fdt_blob, node, "reg",
+					    reg, sizeof(reg));
+		}
+	}
+
+	return 0;
+}
+#endif
+
+int board_init(void)
+{
+	struct udevice *dev;
+	int ret;
+
+	if (CONFIG_IS_ENABLED(USB_GADGET)) {
+		ret = uclass_get_device(UCLASS_USB_GADGET_GENERIC, 0, &dev);
+		if (ret)
+			log_debug("mt6789: USB gadget probe deferred/failed: %d\n", ret);
+	}
+
+	return 0;
+}
+
+int board_late_init(void)
+{
+	struct udevice *vdev = NULL;
+	int vret = -ENODEV;
+	int uret = -ENODEV;
+	int sret = -ENODEV;
+
+	if (CONFIG_IS_ENABLED(VIDEO))
+		vret = uclass_first_device_err(UCLASS_VIDEO, &vdev);
+
+	if (CONFIG_IS_ENABLED(UFS)) {
+		uret = ufs_probe_dev(0);
+		if (!uret && CONFIG_IS_ENABLED(SCSI))
+			sret = scsi_scan(true);
+	}
+
+	printf("\nAdvan X1 (MT6789) U-Boot ready (EL%u, fb=0x%x, video=%d, ufs=%d, scsi=%d)\n",
+	       current_el(), mt6789_active_fb(), vret, uret, sret);
+	if (CONFIG_IS_ENABLED(VIDEO))
+		video_sync_all();
+
+	return 0;
+}
