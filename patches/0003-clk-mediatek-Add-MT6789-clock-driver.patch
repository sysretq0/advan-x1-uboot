From 200f28f4867a759b670db256cb1b6b360053916e Mon Sep 17 00:00:00 2001
From: sysretq0 <324514544+sysretq0@users.noreply.github.com>
Date: Sun, 22 Nov 2026 04:51:29 +0000
Subject: [PATCH] clk: mediatek: Add MT6789 clock driver

Add the MediaTek MT6789 (Helio G99 / MT8781) clock controller driver
covering apmixedsys PLLs, topckgen fixed/divider/mux clocks, and
infracfg_ao peripheral clock gates.

Signed-off-by: sysretq0 <324514544+sysretq0@users.noreply.github.com>
---
 drivers/clk/mediatek/Makefile     |   1 +
 drivers/clk/mediatek/clk-mt6789.c | 618 ++++++++++++++++++++++++++++++
 2 files changed, 619 insertions(+)
 create mode 100644 drivers/clk/mediatek/clk-mt6789.c

diff --git a/drivers/clk/mediatek/Makefile b/drivers/clk/mediatek/Makefile
index 00ebb50a..c1170640 100644
--- a/drivers/clk/mediatek/Makefile
+++ b/drivers/clk/mediatek/Makefile
@@ -3,6 +3,7 @@
 obj-$(CONFIG_ARCH_MEDIATEK) += clk-mtk.o
 
 # SoC Drivers
+obj-$(CONFIG_TARGET_MT6789) += clk-mt6789.o
 obj-$(CONFIG_TARGET_MT7623) += clk-mt7623.o
 obj-$(CONFIG_TARGET_MT7622) += clk-mt7622.o
 obj-$(CONFIG_TARGET_MT7629) += clk-mt7629.o
diff --git a/drivers/clk/mediatek/clk-mt6789.c b/drivers/clk/mediatek/clk-mt6789.c
new file mode 100644
index 00000000..f3e8c033
--- /dev/null
+++ b/drivers/clk/mediatek/clk-mt6789.c
@@ -0,0 +1,618 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * MediaTek MT6789 (Helio G99 / MT8781) clock driver.
+ *
+ * Register maps and clock IDs derived from verified MT6789 mainline Linux
+ * clock bindings (apmixedsys, topckgen, infracfg_ao).
+ */
+
+#include <clk-uclass.h>
+#include <dm.h>
+#include <dm/device_compat.h>
+#include <asm/io.h>
+#include <dt-bindings/clock/mt6789-clk.h>
+
+#include "clk-mtk.h"
+
+#define MT6789_PLL_FMAX		(3800UL * MHZ)
+#define MT6789_PLL_FMIN		(1500UL * MHZ)
+
+enum {
+	CLK_PAD_CLK32K,
+	CLK_PAD_CLK26M,
+	CLK_PAD_CLK13M,
+};
+
+static const ulong ext_clock_rates[] = {
+	[CLK_PAD_CLK32K] = 32000,
+	[CLK_PAD_CLK26M] = 26 * MHZ,
+	[CLK_PAD_CLK13M] = 13 * MHZ,
+};
+
+/* ---- APMIXEDSYS (0x1000c000) ---- */
+
+#define PLL(_id, _reg, _pwr_reg, _en_mask, _flags, _pcwbits, _pd_reg,	\
+	    _pd_shift, _pcw_reg, _pcw_shift) {				\
+		.id = _id,						\
+		.reg = _reg,						\
+		.pwr_reg = _pwr_reg,					\
+		.en_mask = _en_mask,					\
+		.rst_bar_mask = BIT(23),				\
+		.fmin = MT6789_PLL_FMIN,				\
+		.fmax = MT6789_PLL_FMAX,				\
+		.flags = _flags,					\
+		.pcwbits = _pcwbits,					\
+		.pcwibits = 8,						\
+		.pd_reg = _pd_reg,					\
+		.pd_shift = _pd_shift,					\
+		.pcw_reg = _pcw_reg,					\
+		.pcw_shift = _pcw_shift,				\
+	}
+
