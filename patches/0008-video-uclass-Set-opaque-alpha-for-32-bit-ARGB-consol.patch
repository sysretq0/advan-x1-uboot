From fe9d67e85f31fbdfed682c294100c403a8881f21 Mon Sep 17 00:00:00 2001
From: sysretq0 <324514544+sysretq0@users.noreply.github.com>
Date: Sat, 21 Nov 2026 18:44:39 +0000
Subject: [PATCH] video: uclass: Set opaque alpha for 32-bit ARGB console
 colors

---
 drivers/video/video-uclass.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/drivers/video/video-uclass.c b/drivers/video/video-uclass.c
index 22183d00..0cbb16d4 100644
--- a/drivers/video/video-uclass.c
+++ b/drivers/video/video-uclass.c
@@ -355,7 +355,8 @@ u32 video_index_to_colour(struct video_priv *priv, enum colour_idx idx)
 				       (colours[idx].g << 16) |
 				       (colours[idx].b << 8) | 0xff;
 			default:
-				return (colours[idx].r << 16) |
+				return 0xff000000U |
+				       (colours[idx].r << 16) |
 				       (colours[idx].g <<  8) |
 				       (colours[idx].b <<  0);
 			}
@@ -370,9 +371,9 @@ u32 video_index_to_colour(struct video_priv *priv, enum colour_idx idx)
 	 * black and white.
 	 */
 	if (idx)
-		return 0xffffff; /* white */
+		return 0xffffffffU; /* white */
 
-	return 0x000000; /* black */
+	return 0xff000000U; /* black */
 }
 
 void video_set_default_colors(struct udevice *dev, bool invert)
-- 
2.55.0

