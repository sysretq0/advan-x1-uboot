/*
 * Advan X1 (MediaTek MT6789 / Helio G99) U-Boot Device Tree.
 */

/dts-v1/;

#include <dt-bindings/input/input.h>
#include "mt6789.dtsi"

/ {
	model = "Advan X1";
	compatible = "advan,x1", "mediatek,mt6789";

	aliases {
		serial0 = &uart0;
	};

	chosen {
		stdout-path = "serial0:921600n8";
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		/*
		 * Pre-initialized DSI video-mode framebuffer (1080x2460 visible,
		 * 1088px = 4352B stride, 2464 total lines). board_fix_fdt()
		 * updates reg to the active OVL0_L0_ADDR before simplefb probes.
		 */
		framebuffer@fe007000 {
			compatible = "simple-framebuffer";
			reg = <0x0 0xfe007000 0x0 0x00a3a000>;
			width = <1080>;
			height = <2460>;
			stride = <4352>;
			format = "a8r8g8b8";
			status = "okay";
		};
	};

	/*
	 * Clean DRAM windows outside secure/coprocessor/modem reservations:
	 *   - Bank 0: 0x60000000..0x6EFFFFFF (240 MiB, U-Boot & kernel staging)
	 *   - Bank 1: 0x100000000..0x13FDFFFFF (1022 MiB, stops 2 MiB below dramc-rk0)
	 *   - Bank 2: 0x140000000..0x23FDFFFFF (4094 MiB, stops 2 MiB below dramc-rk1)
	 * Linux boots its own FIT DTB (CONFIG_ARCH_FIXUP_FDT_MEMORY=n) with the
	 * full 8 GiB /memory@40000000 node and all stock no-map carveouts.
	 */
	memory@60000000 {
		device_type = "memory";
		reg = <0x0 0x60000000 0x0 0x0f000000>,
		      <0x1 0x00000000 0x0 0x3fe00000>,
		      <0x1 0x40000000 0x0 0xffe00000>;
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		ramoops@48090000 {
			reg = <0x0 0x48090000 0x0 0x000e0000>;
			no-map;
		};

		framebuffer_reserved: framebuffer@fe007000 {
			reg = <0x0 0xfe007000 0x0 0x01ff8000>;
			no-map;
		};
	};
};

&uart0 {
	status = "okay";
};

&keyboard {
	keypad,num-rows = <1>;
	keypad,num-columns = <1>;
	linux,keymap = <MATRIX_KEY(0, 0, KEY_VOLUMEDOWN)>;
	status = "okay";
};

&pwrap {
	status = "okay";

	pmic: pmic {
		compatible = "mediatek,mt6366", "mediatek,mt6358";

		keys {
			compatible = "mediatek,mt6358-keys";

			power {
				linux,keycodes = <KEY_POWER>;
			};

			home {
				linux,keycodes = <KEY_VOLUMEUP>;
			};
		};
	};
};

&ufshci {
	status = "okay";
};

&u2phy0 {
	status = "okay";
};

&usb0 {
	status = "okay";
};
