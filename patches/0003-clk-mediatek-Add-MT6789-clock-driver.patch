+	    22, 0x0394, 24, 0x0394, 0),
+	PLL(CLK_APMIXED_MAINPLL, 0x0340, 0x034c, 0xff000001,
+	    CLK_PLL_HAVE_RST_BAR, 22, 0x0344, 24, 0x0344, 0),
+	PLL(CLK_APMIXED_UNIVPLL, 0x0308, 0x0314, 0xff000001,
