From 0df2ef353d91bf8008f659745265ee5980a585dd Mon Sep 17 00:00:00 2001
From: sysretq0 <324514544+sysretq0@users.noreply.github.com>
Date: Sat, 21 Nov 2026 19:39:21 +0000
Subject: [PATCH] efi_loader: gop: Respect video line_length stride and opaque
 alpha

---
 lib/efi_loader/efi_gop.c | 10 ++++++----
 1 file changed, 6 insertions(+), 4 deletions(-)

diff --git a/lib/efi_loader/efi_gop.c b/lib/efi_loader/efi_gop.c
index ae44d140..bf5648f2 100644
--- a/lib/efi_loader/efi_gop.c
+++ b/lib/efi_loader/efi_gop.c
@@ -172,7 +172,7 @@ static __always_inline efi_status_t gop_blt_int(struct efi_gop *this,
 		break;
 	case EFI_BLT_VIDEO_TO_BLT_BUFFER:
 	case EFI_BLT_VIDEO_TO_VIDEO:
-		swidth = gopobj->info.width;
+		swidth = gopobj->info.pixels_per_scanline;
 		if (!vid_bpp)
 			return EFI_UNSUPPORTED;
 		break;
@@ -185,7 +185,7 @@ static __always_inline efi_status_t gop_blt_int(struct efi_gop *this,
 	case EFI_BLT_BUFFER_TO_VIDEO:
 	case EFI_BLT_VIDEO_FILL:
 	case EFI_BLT_VIDEO_TO_VIDEO:
-		dwidth = gopobj->info.width;
+		dwidth = gopobj->info.pixels_per_scanline;
 		if (!vid_bpp)
 			return EFI_UNSUPPORTED;
 		break;
@@ -231,7 +231,8 @@ static __always_inline efi_status_t gop_blt_int(struct efi_gop *this,
 			case EFI_BLT_VIDEO_FILL:
 			case EFI_BLT_VIDEO_TO_VIDEO:
 				if (vid_bpp == 32)
-					fb32[dlineoff + j + dx] = *(u32 *)&pix;
+					fb32[dlineoff + j + dx] =
+						*(u32 *)&pix | 0xff000000U;
 				else if (vid_bpp == 30)
 					fb32[dlineoff + j + dx] =
 						efi_blt_col_to_vid30(&pix);
@@ -550,7 +551,8 @@ efi_status_t efi_gop_register(void)
 		gopobj->info.pixel_bitmask[1] = 0x07e0; /* green */
 		gopobj->info.pixel_bitmask[2] = 0x001f; /* blue */
 	}
-	gopobj->info.pixels_per_scanline = col;
+	gopobj->info.pixels_per_scanline =
+		priv->line_length ? priv->line_length / VNBYTES(bpix) : col;
 	gopobj->bpix = bpix;
 	gopobj->fb = priv->fb;
 	gopobj->vdev = vdev;
-- 
2.55.0

