+
+/* Early stack/GD inside verified clean mid-DRAM staging region */
+#define CFG_SYS_INIT_RAM_ADDR		0x60000000
+#define CFG_SYS_INIT_RAM_SIZE		SZ_2M
+
+/*
+ * Standard ARM64 staging coordinates inside the verified clean
+ * 0x60000000..0x6F000000 DRAM window (2 MiB aligned for Linux Image):
+ *   - kernel_addr_r      : 0x61000000 (88 MiB headroom for uncompressed Image + BSS)
+ *   - ramdisk_addr_r     : 0x66800000 (24 MiB headroom before FIT staging)
+ *   - fit_addr_r         : 0x68000000 (80 MiB staging window for FIT / compressed Image)
+ *   - fdt_high/initrd_hi : 0x6E000000 (keeps relocated FDT & initrd inside memory@61000000)
+ */
