From 33edff9a51805d8b74f3115d6f5088cd404ee55e Mon Sep 17 00:00:00 2001
From: sysretq0 <324514544+sysretq0@users.noreply.github.com>
Date: Sat, 21 Nov 2026 18:44:38 +0000
Subject: [PATCH] arm: mediatek: Add MT6789 (Helio G99) SoC support

---
 arch/arm/mach-mediatek/Kconfig         |  11 ++
 arch/arm/mach-mediatek/Makefile        |   3 +
 arch/arm/mach-mediatek/mt6789/Makefile |   3 +
 arch/arm/mach-mediatek/mt6789/init.c   | 139 +++++++++++++++++++++++++
 4 files changed, 156 insertions(+)
 create mode 100644 arch/arm/mach-mediatek/mt6789/Makefile
 create mode 100644 arch/arm/mach-mediatek/mt6789/init.c

diff --git a/arch/arm/mach-mediatek/Kconfig b/arch/arm/mach-mediatek/Kconfig
index cd841098..689505cd 100644
--- a/arch/arm/mach-mediatek/Kconfig
+++ b/arch/arm/mach-mediatek/Kconfig
@@ -9,6 +9,15 @@ config SYS_VENDOR
 choice
 	prompt "MediaTek board select"
 
+config TARGET_MT6789
+	bool "MediaTek MT6789 (Helio G99) SoC"
+	select ARM64
+	help
+	  The MediaTek MT6789 (Helio G99 / MT8781) is an ARM64 SoC with two
+	  Cortex-A76 performance cores and six Cortex-A55 efficiency cores,
+	  including UFS 2.2, USB 2.0 MUSB, UART, SPI, I2C, PMIC wrapper,
+	  and MIPI-DSI display subsystem.
+
 config TARGET_MT7622
 	bool "MediaTek MT7622 SoC"
 	select ARM64
@@ -187,6 +196,7 @@ endif
 
 config SYS_BOARD
 	string "Board name"
+	default "mt6789" if TARGET_MT6789
 	default "mt7622" if TARGET_MT7622
 	default "mt7623" if TARGET_MT7623
 	default "mt7629" if TARGET_MT7629
@@ -205,6 +215,7 @@ config SYS_BOARD
 	  be used.
 
 config SYS_CONFIG_NAME
+	default "mt6789" if TARGET_MT6789
 	default "mt7623" if TARGET_MT7623
 	default "mt7629" if TARGET_MT7629
 	default "mt7981" if TARGET_MT7981
diff --git a/arch/arm/mach-mediatek/Makefile b/arch/arm/mach-mediatek/Makefile
index 661fc0b8..b4ce84db 100644
--- a/arch/arm/mach-mediatek/Makefile
+++ b/arch/arm/mach-mediatek/Makefile
@@ -1,11 +1,14 @@
 # SPDX-License-Identifier:	GPL-2.0
 
+ifndef CONFIG_TARGET_MT6789
 obj-$(CONFIG_ARM64) += armv8-mem-map.o
+endif
 obj-y	+= cpu.o
 obj-$(CONFIG_MTK_TZ_MOVABLE)	+= tzcfg.o
 obj-$(CONFIG_XPL_BUILD)	+= spl.o
 obj-$(CONFIG_$(PHASE_)MTK_FIRMWARE_AB) += spl_ab.o mtk_ab.o
 
+obj-$(CONFIG_TARGET_MT6789) += mt6789/
 obj-$(CONFIG_TARGET_MT7622) += mt7622/
 obj-$(CONFIG_TARGET_MT7623) += mt7623/
 obj-$(CONFIG_TARGET_MT7629) += mt7629/
diff --git a/arch/arm/mach-mediatek/mt6789/Makefile b/arch/arm/mach-mediatek/mt6789/Makefile
new file mode 100644
index 00000000..b9a1e6b6
--- /dev/null
+++ b/arch/arm/mach-mediatek/mt6789/Makefile
@@ -0,0 +1,3 @@
+# SPDX-License-Identifier: GPL-2.0
+
+obj-y += init.o
diff --git a/arch/arm/mach-mediatek/mt6789/init.c b/arch/arm/mach-mediatek/mt6789/init.c
new file mode 100644
index 00000000..14e3b120
--- /dev/null
+++ b/arch/arm/mach-mediatek/mt6789/init.c
@@ -0,0 +1,139 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * MediaTek MT6789 (Helio G99 / MT8781) SoC initialization and memory map.
+ *
+ * Physical memory map derived from verified MT6789 mblock reservations and
+ * live /proc/iomem audits on Advan X1 (8 GiB LPDDR4X). Secure EL3 (BL31),
+ * TrustZone TEE (Kinibi), SSPM, SCP/SPM/MCUPM, and RKP windows are
+ * deliberately left unmapped so Cortex-A76 speculative accesses cannot
+ * trigger bus firewall SErrors.
+ */
+
+#include <cpu_func.h>
+#include <fdtdec.h>
+#include <init.h>
+#include <stdio.h>
+#include <asm/armv8/mmu.h>
+#include <asm/global_data.h>
+#include <asm/system.h>
+#include <linux/kernel.h>
+#include <linux/sizes.h>
+
+DECLARE_GLOBAL_DATA_PTR;
+
+static struct mm_region mt6789_mem_map[] = {
+	{
+		/* SoC MMIO: GIC, topckgen, infracfg, WDT, pwrap, UART, USB, UFS, MMSYS */
+		.virt = 0x00000000UL,
+		.phys = 0x00000000UL,
+		.size = 0x20000000UL,
+		.attrs = PTE_BLOCK_MEMTYPE(MT_DEVICE_NGNRNE) |
+			 PTE_BLOCK_NON_SHARE |
+			 PTE_BLOCK_PXN | PTE_BLOCK_UXN,
+	},
+	{
+		/* Low DRAM before BL31/pstore/aee (0x48080000..0x48700000 unmapped) */
+		.virt = 0x40000000UL,
+		.phys = 0x40000000UL,
+		.size = 0x08000000UL,
+		.attrs = PTE_BLOCK_MEMTYPE(MT_NORMAL) | PTE_BLOCK_OUTER_SHARE,
+	},
+	{
+		/*
+		 * Mid DRAM: U-Boot staging/relocation & Linux bundle.
+		 * Starts above aee_lk/stock LK (0x50700000..0x51000000) and
+		 * stops before TrustZone TEE (0x70000000). EMI-MPU firewalled
+		 * modem/SCP/SSPM/RKP windows in 0x70000000..0xFDFFFFFF are
+		 * deliberately left unmapped.
+		 */
+		.virt = 0x51000000UL,
+		.phys = 0x51000000UL,
+		.size = 0x1e000000UL,
+		.attrs = PTE_BLOCK_MEMTYPE(MT_NORMAL) | PTE_BLOCK_OUTER_SHARE,
+	},
+	{
+		/* Stock LK DSI video-mode framebuffer (0xFE007000 / 0xFEA41000) */
+		.virt = 0xfe000000UL,
+		.phys = 0xfe000000UL,
+		.size = 0x02000000UL,
+		.attrs = PTE_BLOCK_MEMTYPE(MT_NORMAL_NC) |
+			 PTE_BLOCK_OUTER_SHARE |
+			 PTE_BLOCK_PXN | PTE_BLOCK_UXN,
+	},
+	{
+		/* Verified clean high DRAM window (3.64 GiB) */
+		.virt = 0x140000000UL,
+		.phys = 0x140000000UL,
+		.size = 0x0e9700000UL,
+		.attrs = PTE_BLOCK_MEMTYPE(MT_NORMAL) | PTE_BLOCK_OUTER_SHARE,
+	},
+	{
+		/* List terminator */
+	},
+};
+
+struct mm_region *mem_map = mt6789_mem_map;
+
+/*
+ * Active framebuffer physical address handed off in x0 by Stage-1 LK
+ * (stored in .data so clear_bss does not wipe it before board_fix_fdt).
+ */
+u32 mt6789_boot_fb __section(".data");
+
+__asm__(
+	".globl save_boot_params\n"
+	"save_boot_params:\n"
+	"	adrp	x9, mt6789_boot_fb\n"
+	"	add	x9, x9, :lo12:mt6789_boot_fb\n"
+	"	str	w0, [x9]\n"
+	"	b	save_boot_params_ret\n"
+);
+
+int mach_cpu_init(void)
+{
+	return 0;
+}
+
+u64 get_page_table_size(void)
+{
+	/*
+	 * Reserve generous page-table space (64 tables) so simplefb's runtime
+	 * mmu_map_region() on the 4 KiB-aligned framebuffer (0xFE007000) can
+	 * split 2 MiB blocks into L3 pages without exhausting tlb_fillptr.
+	 */
+	return SZ_256K;
+}
+
+int dram_init(void)
+{
+	return fdtdec_setup_mem_size_base();
+}
+
+int dram_init_banksize(void)
+{
+	return fdtdec_setup_memory_banksize();
+}
+
+phys_addr_t board_get_usable_ram_top(phys_size_t total_size)
+{
+	/*
+	 * Keep U-Boot relocation, malloc pool, and stack strictly inside the
+	 * verified clean low-4G window (0x60000000..0x6F000000) so U-Boot
+	 * never touches TrustZone TEE (0x70000000) or the live LK framebuffer
+	 * (0xFE007000), and DMA buffers stay 32-bit addressable.
+	 */
+	return min(gd->ram_top, (phys_addr_t)0x6f000000UL);
+}
+
+#if !CONFIG_IS_ENABLED(SYSRESET)
+void reset_cpu(void)
+{
+	psci_system_reset();
+}
+#endif
+
+int print_cpuinfo(void)
+{
+	printf("CPU:   MediaTek MT6789 (Helio G99)\n");
+	return 0;
+}
-- 
2.55.0

