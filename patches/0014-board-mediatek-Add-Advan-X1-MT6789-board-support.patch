+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * Configuration header for MediaTek MT6789 (Advan X1).
+ */
+
+#ifndef __MT6789_H
+#define __MT6789_H
+
+#include <linux/sizes.h>
+
+/* Early stack/GD inside clean mid-DRAM staging region */
+#define CFG_SYS_INIT_RAM_ADDR		0x60000000
+#define CFG_SYS_INIT_RAM_SIZE		SZ_2M
+
+/*
+ * Standard ARM64 staging coordinates inside the clean 0x60000000..0x6F000000
+ * DRAM window (2 MiB aligned for Linux Image):
+ *   - kernel_addr_r      : 0x61000000 (88 MiB headroom for Image + BSS)
+ *   - ramdisk_addr_r     : 0x66800000 (24 MiB headroom before FIT staging)
+ *   - fit_addr_r         : 0x68000000 (80 MiB staging window for FIT / Image)
+ *   - fdt_high/initrd_hi : 0x6E000000 (keeps relocated FDT/initrd in Bank 0)
+ */
+#define CFG_EXTRA_ENV_SETTINGS \
+	"stdin=serial,button-kbd\0" \
+	"stdout=serial,vidconsole\0" \
+	"stderr=serial,vidconsole\0" \
+	"fdt_high=0x6e000000\0" \
+	"initrd_high=0x6e000000\0" \
+	"scriptaddr=0x60300000\0" \
+	"pxefile_addr_r=0x60380000\0" \
+	"fdt_addr_r=0x60400000\0" \
+	"fdtoverlay_addr_r=0x60500000\0" \
+	"kernel_addr_r=0x61000000\0" \
+	"ramdisk_addr_r=0x66800000\0" \
+	"fit_addr_r=0x68000000\0" \
+	"kernel_comp_addr_r=0x68000000\0" \
+	"kernel_comp_size=0x03000000\0" \
+	"menucmd=bootmenu -1\0" \
+	"bootmenu_0=Boot Mainline Linux=" \
+		"bootmeth order script extlinux; " \
+		"bootflow scan -lb; pause; run menucmd\0" \
+	"bootmenu_1=Boot UEFI=" \
+		"bootmeth order efi efi_mgr; " \
+		"bootflow scan -lb; pause; run menucmd\0" \
+	"bootmenu_2=USB Fastboot Mode=" \
+		"echo Starting USB Fastboot (scsi 2)...; " \
+		"fastboot usb 0; pause; run menucmd\0" \
+	"bootmenu_3=USB Serial Console=" \
+		"setenv stdin serial,button-kbd,usbacm; " \
+		"setenv stdout serial,vidconsole,usbacm; " \
+		"setenv stderr serial,vidconsole,usbacm; " \
+		"echo USB CDC-ACM console active (run menucmd to return)\0" \
+	"bootmenu_4=Reboot=reset\0" \
+	"bootmenu_5=Power Off=poweroff\0" \
+	"bootmenu_delay=-1\0"
+
+#endif /* __MT6789_H */
