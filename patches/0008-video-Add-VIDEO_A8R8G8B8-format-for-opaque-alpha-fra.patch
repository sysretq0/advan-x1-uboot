From 9e954e174020dbb6067f2555acc0029d71fa5b5a Mon Sep 17 00:00:00 2001
From: sysretq0 <324514544+sysretq0@users.noreply.github.com>
Date: Sun, 22 Nov 2026 04:56:55 +0000
Subject: [PATCH] video: Add VIDEO_A8R8G8B8 format for opaque alpha
 framebuffers

Add VIDEO_A8R8G8B8 to enum video_format and map the simple-framebuffer
"a8r8g8b8" format to it instead of VIDEO_X8R8G8B8. In
video_index_to_colour(), emit opaque alpha (0xff000000) for
VIDEO_A8R8G8B8 so display controllers with per-pixel alpha blending
(such as MediaTek DISP_OVL0) render console pixels visibly while
preserving existing VIDEO_X8R8G8B8 behavior and sandbox video tests.

Signed-off-by: sysretq0 <324514544+sysretq0@users.noreply.github.com>
---
 drivers/video/simplefb.c     | 6 ++++--
 drivers/video/video-uclass.c | 5 +++++
 include/video.h              | 1 +
 3 files changed, 10 insertions(+), 2 deletions(-)

diff --git a/drivers/video/simplefb.c b/drivers/video/simplefb.c
index ba08fc04..c726fcbb 100644
--- a/drivers/video/simplefb.c
+++ b/drivers/video/simplefb.c
@@ -86,8 +86,10 @@ static int simple_video_probe(struct udevice *dev)
 		   strcmp(format, "x8b8g8r8") == 0) {
 		uc_priv->bpix = VIDEO_BPP32;
 		uc_priv->format = VIDEO_X8B8G8R8;
-	} else if (strcmp(format, "a8r8g8b8") == 0 ||
-		   strcmp(format, "x8r8g8b8") == 0) {
+	} else if (strcmp(format, "a8r8g8b8") == 0) {
+		uc_priv->bpix = VIDEO_BPP32;
+		uc_priv->format = VIDEO_A8R8G8B8;
+	} else if (strcmp(format, "x8r8g8b8") == 0) {
 		uc_priv->bpix = VIDEO_BPP32;
 		uc_priv->format = VIDEO_X8R8G8B8;
 	} else if (strcmp(format, "a2r10g10b10") == 0 ||
diff --git a/drivers/video/video-uclass.c b/drivers/video/video-uclass.c
index 22183d00..fa26171c 100644
--- a/drivers/video/video-uclass.c
+++ b/drivers/video/video-uclass.c
@@ -354,6 +354,11 @@ u32 video_index_to_colour(struct video_priv *priv, enum colour_idx idx)
 				return (colours[idx].r << 24) |
 				       (colours[idx].g << 16) |
 				       (colours[idx].b << 8) | 0xff;
+			case VIDEO_A8R8G8B8:
+				return 0xff000000U |
+				       (colours[idx].r << 16) |
+				       (colours[idx].g <<  8) |
+				       (colours[idx].b <<  0);
 			default:
 				return (colours[idx].r << 16) |
 				       (colours[idx].g <<  8) |
diff --git a/include/video.h b/include/video.h
index 8e4c1544..1be5c5b3 100644
--- a/include/video.h
+++ b/include/video.h
@@ -66,6 +66,7 @@ enum video_format {
 	VIDEO_RGBA8888,
 	VIDEO_X8B8G8R8,
 	VIDEO_X8R8G8B8,
+	VIDEO_A8R8G8B8,
 	VIDEO_X2R10G10B10,
 };
 
-- 
