+	PLL(CLK_APMIXED_MSDCPLL, 0x0350, 0x035c, BIT(0), 0,
+	    22, 0x0354, 24, 0x0354, 0),
+	PLL(CLK_APMIXED_MMPLL, 0x0360, 0x036c, 0xff000001,
