@@ -0,0 +1,121 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Board support for Advan X1 (MediaTek MT6789 / Helio G99).
+ */
+
+#include <dm.h>
+#include <fdt_support.h>
+#include <init.h>
+#include <log.h>
+#include <mapmem.h>
+#include <scsi.h>
+#include <ufs.h>
+#include <asm/arch/mt6789.h>
+#include <asm/io.h>
+#include <linux/libfdt.h>
+
+/* MT6789 DISP_OVL0 active Layer 0 physical framebuffer address register */
+#define MT6789_OVL0_L0_ADDR	0x14005f40
+#define MT6789_FB_WINDOW_MIN	0xfe000000U
+#define MT6789_FB_WINDOW_MAX	0xff800000U
+#define MT6789_FB_PHYS_0	0xfe007000U
+#define MT6789_FB_SIZE_BYTES	0x00a3a000U /* 1088 * 4 * 2464 */
+
+static u32 mt6789_active_fb(void)
+{
+	u32 ovl_fb = readl(MT6789_OVL0_L0_ADDR);
+
+	if (ovl_fb >= MT6789_FB_WINDOW_MIN && ovl_fb <= MT6789_FB_WINDOW_MAX)
+		return ovl_fb;
+
+	if (mt6789_boot_fb >= MT6789_FB_WINDOW_MIN &&
+	    mt6789_boot_fb <= MT6789_FB_WINDOW_MAX)
+		return mt6789_boot_fb;
+
+	return MT6789_FB_PHYS_0;
+}
+
+int board_fix_fdt(void *rw_fdt_blob)
+{
+	static const u32 fb_planes[3] = {
+		MT6789_FB_PHYS_0,
+		MT6789_FB_PHYS_0 + MT6789_FB_SIZE_BYTES,
+		MT6789_FB_PHYS_0 + MT6789_FB_SIZE_BYTES * 2U,
+	};
+	u32 live_fb = mt6789_active_fb();
+	u32 i, p;
+	int node;
+
+	/*
+	 * DISP_OVL0 composites Layer 0 (simplefb) underneath any prior-stage
+	 * overlay planes using per-pixel alpha (OVL_CON_AEN).
+	 * - Fill the active L0 plane with opaque black (0xFF000000).
+	 * - Zero secondary planes (alpha=0) so prior-stage overlay content
+	 *   becomes transparent instead of occluding U-Boot's console.
+	 */
+	for (p = 0; p < ARRAY_SIZE(fb_planes); p++) {
+		void __iomem *fb = map_physmem(fb_planes[p],
+					       MT6789_FB_SIZE_BYTES,
+					       MAP_NOCACHE);
+		u64 fill = (fb_planes[p] == live_fb) ?
+			   0xff000000ff000000ULL : 0ULL;
+
+		for (i = 0; i < MT6789_FB_SIZE_BYTES; i += sizeof(u64))
+			__raw_writeq(fill, fb + i);
+		unmap_physmem(fb, MAP_NOCACHE);
+	}
+	dsb();
+
+	/*
+	 * Patch simple-framebuffer reg in-place to the active OVL0 scanout
+	 * buffer before DM video probes.
+	 */
+	node = fdt_node_offset_by_compatible(rw_fdt_blob, -1,
+					     "simple-framebuffer");
+	if (node >= 0) {
+		fdt32_t reg[4] = {
+			cpu_to_fdt32(0),
+			cpu_to_fdt32(live_fb),
+			cpu_to_fdt32(0),
+			cpu_to_fdt32(MT6789_FB_SIZE_BYTES),
+		};
+
+		fdt_setprop_inplace(rw_fdt_blob, node, "reg",
+				    reg, sizeof(reg));
+	}
+
+	return 0;
+}
+
+int board_init(void)
+{
+	struct udevice *dev;
+	int ret;
+
+	if (CONFIG_IS_ENABLED(USB_GADGET)) {
+		ret = uclass_get_device(UCLASS_USB_GADGET_GENERIC, 0, &dev);
+		if (ret)
+			log_debug("mt6789: USB gadget probe deferred: %d\n", ret);
+	}
+
+	return 0;
+}
+
+int board_late_init(void)
+{
+	struct udevice *vdev = NULL;
+	int ret;
+
+	if (CONFIG_IS_ENABLED(VIDEO))
+		uclass_first_device_err(UCLASS_VIDEO, &vdev);
+
+	if (CONFIG_IS_ENABLED(UFS)) {
+		ret = ufs_probe_dev(0);
+		if (ret)
+			log_warning("mt6789: UFS probe failed: %d\n", ret);
+		else if (CONFIG_IS_ENABLED(SCSI))
+			scsi_scan(true);
+	}
+
+	return 0;
+}
