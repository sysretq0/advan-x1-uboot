diff --git a/arch/arm/mach-mediatek/mt6789/init.c b/arch/arm/mach-mediatek/mt6789/init.c
new file mode 100644
index 000000000..e37007396
--- /dev/null
+++ b/arch/arm/mach-mediatek/mt6789/init.c
@@ -0,0 +1,122 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * MediaTek MT6789 (Helio G99 / MT8781) SoC initialization and memory map.
+ *
+ * Secure EL3 (BL31), TrustZone TEE, SSPM, SCP/SPM/MCUPM, and RKP windows
+ * are deliberately left unmapped so Cortex-A76 speculative accesses cannot
+ * trigger bus firewall SErrors.
+ */
+
+#include <cpu_func.h>
+#include <fdtdec.h>
+#include <init.h>
+#include <stdio.h>
+#include <asm/armv8/mmu.h>
+#include <asm/global_data.h>
+#include <linux/kernel.h>
+#include <linux/sizes.h>
+
+DECLARE_GLOBAL_DATA_PTR;
+
+static struct mm_region mt6789_mem_map[] = {
+	{
+		/* SoC MMIO: GIC, topckgen, infracfg, WDT, pwrap, UART, USB, UFS, MMSYS */
+		.virt = 0x00000000UL,
+		.phys = 0x00000000UL,
+		.size = 0x20000000UL,
+		.attrs = PTE_BLOCK_MEMTYPE(MT_DEVICE_NGNRNE) |
+			 PTE_BLOCK_NON_SHARE |
+			 PTE_BLOCK_PXN | PTE_BLOCK_UXN,
+	},
+	{
+		/* Low DRAM before BL31/pstore/aee (0x48080000..0x48700000 unmapped) */
+		.virt = 0x40000000UL,
+		.phys = 0x40000000UL,
+		.size = 0x08000000UL,
+		.attrs = PTE_BLOCK_MEMTYPE(MT_NORMAL) | PTE_BLOCK_OUTER_SHARE,
+	},
+	{
+		/*
+		 * Mid DRAM: Fastboot buffer (0x52000000), U-Boot staging/relocation,
+		 * and Linux payload (0x60000000..0x6EFFFFFF). Starts above prior-stage
+		 * bootloader memory (0x50700000..0x51000000) and stops before
+		 * TrustZone TEE (0x70000000). Secure/coprocessor and modem windows in
+		 * 0x70000000..0xFDFFFFFF are left unmapped from U-Boot's VA map;
+		 * Loki preserves LK EMI MPU permissions for Linux modem access.
+		 */
+		.virt = 0x51000000UL,
+		.phys = 0x51000000UL,
+		.size = 0x1e000000UL,
+		.attrs = PTE_BLOCK_MEMTYPE(MT_NORMAL) | PTE_BLOCK_OUTER_SHARE,
+	},
+	{
+		/* Pre-initialized DSI video-mode framebuffer window */
+		.virt = 0xfe000000UL,
+		.phys = 0xfe000000UL,
+		.size = 0x02000000UL,
+		.attrs = PTE_BLOCK_MEMTYPE(MT_NORMAL_NC) |
+			 PTE_BLOCK_OUTER_SHARE |
+			 PTE_BLOCK_PXN | PTE_BLOCK_UXN,
+	},
+	{
+		/* High DRAM Rank 0 above 4 GiB (stops 2 MiB below dramc-rk0) */
+		.virt = 0x100000000UL,
+		.phys = 0x100000000UL,
+		.size = 0x03fe00000UL,
+		.attrs = PTE_BLOCK_MEMTYPE(MT_NORMAL) | PTE_BLOCK_OUTER_SHARE,
+	},
+	{
+		/* High DRAM Rank 1 above 5 GiB (stops 2 MiB below dramc-rk1) */
+		.virt = 0x140000000UL,
+		.phys = 0x140000000UL,
+		.size = 0x0ffe00000UL,
+		.attrs = PTE_BLOCK_MEMTYPE(MT_NORMAL) | PTE_BLOCK_OUTER_SHARE,
+	},
+	{
+		/* List terminator */
+	},
+};
+
+struct mm_region *mem_map = mt6789_mem_map;
+
+int mach_cpu_init(void)
+{
+	return 0;
+}
+
+u64 get_page_table_size(void)
+{
+	/*
+	 * Reserve 256 KiB (64 page tables) so simplefb's runtime
+	 * mmu_map_region() on a 4 KiB-aligned framebuffer can split 2 MiB
+	 * blocks into L3 pages without exhausting tlb_fillptr.
+	 */
+	return SZ_256K;
+}
+
+int dram_init(void)
+{
+	return fdtdec_setup_mem_size_base();
+}
+
+int dram_init_banksize(void)
+{
+	return fdtdec_setup_memory_banksize();
+}
+
+phys_addr_t board_get_usable_ram_top(phys_size_t total_size)
+{
+	/*
+	 * Keep U-Boot relocation, malloc pool, and stack strictly inside the
+	 * low-4G clean DRAM window (0x60000000..0x6F000000) so U-Boot never
+	 * touches TrustZone TEE (0x70000000) or the active framebuffer, and
+	 * DMA buffers remain 32-bit addressable.
+	 */
+	return min_t(phys_addr_t, gd->ram_top, 0x6f000000UL);
+}
+
+int print_cpuinfo(void)
+{
+	printf("CPU:   MediaTek MT6789 (Helio G99)\n");
+	return 0;
+}
diff --git a/arch/arm/mach-mediatek/mt6789/lowlevel_init.S b/arch/arm/mach-mediatek/mt6789/lowlevel_init.S
new file mode 100644
index 000000000..bd66a3e98
--- /dev/null
+++ b/arch/arm/mach-mediatek/mt6789/lowlevel_init.S
@@ -0,0 +1,24 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * Low-level boot parameter capture for MediaTek MT6789.
+ *
+ * Stash the active framebuffer physical address passed in x0 by an earlier
+ * bootloader stage in .data so BSS zeroing does not wipe it before
+ * board_fix_fdt() runs.
+ */
+
+#include <linux/linkage.h>
+
+.section .data
+.align 2
+.globl mt6789_boot_fb
+mt6789_boot_fb:
+	.word	0
+
+.section .text
+ENTRY(save_boot_params)
+	adrp	x9, mt6789_boot_fb
+	add	x9, x9, :lo12:mt6789_boot_fb
+	str	w0, [x9]
+	b	save_boot_params_ret
+ENDPROC(save_boot_params)
-- 
